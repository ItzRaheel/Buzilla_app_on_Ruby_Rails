<!DOCTYPE html>
<html>
  <head>
    <title>Bugzilla App</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <%= javascript_importmap_tags %>
    
    <style>
      /* Only essential custom styles that Bootstrap can't provide */
      body {
        padding-top: 70px;
        /* background: linear-gradient(270deg, #3c4980 0%, #764ba2 100%) !important; */
        /* background-color: #f8f9fa; Light gray background */
        min-height: 100vh;
      }
      .navbar {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%) !important;
      }
    </style>
  </head>

  <body>
    <!-- Navbar with gradient background -->
    <nav class="navbar navbar-expand-lg navbar-dark fixed-top shadow">
      <div class="container-fluid">
        <%= link_to " Bugzilla App", root_path, class: "navbar-brand fw-bold fs-4" %>
        
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav"
                aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
          <span class="navbar-toggler-icon"></span>
        </button>
        
        <div class="collapse navbar-collapse" id="navbarNav">
          <!-- Left-aligned navigation links -->
          <ul class="navbar-nav me-auto mb-2 mb-lg-0">
            <li class="nav-item">
              <%= link_to "Bugs", bugs_path, class: "nav-link fw-semibold px-3" %>
            </li>
            <li class="nav-item">
              <%= link_to " Reports", reports_path, class: "nav-link fw-semibold px-3" %>
            </li>
            <li class="nav-item">
              <%= link_to " Projects", projects_path, class: "nav-link fw-semibold px-3" %>
            </li>
          </ul>

          <!-- Right-aligned user actions -->
          <ul class="navbar-nav ms-auto mb-2 mb-lg-0 align-items-lg-center">
            <% if user_signed_in? %>
              <li class="nav-item me-2">
                <span class="badge bg-light bg-opacity-25 text-white fw-semibold py-2 px-3">
                  👤 <%= current_user.name %>
                </span>
              </li>
              
              <li class="nav-item me-2">
                <span class="text-white text-opacity-75 small px-2">
                  <%= current_user.email %>
                </span>
              </li>
              
              <li class="nav-item me-3">
                <span class="badge bg-warning text-dark fw-semibold py-2 px-3">
                  🔑 <%= current_user.role.upcase %>
                </span>
              </li>
              
              <li class="nav-item">
                <%= button_to "🚪 Logout",
                              destroy_user_session_path,
                              method: :delete,
                              class: "btn btn-danger fw-semibold px-4",
                              data: { 
                                turbo_confirm: "Are you sure you want to log out?" 
                              } %>
              </li>
            <% else %>
              <li class="nav-item me-2">
                <%= link_to "🔐 Login", new_user_session_path, class: "btn btn-outline-light fw-semibold" %>
              </li>
              <li class="nav-item">
                <%= link_to "✍️ Sign up", new_user_registration_path, class: "btn btn-light text-dark fw-bold" %>
              </li>
            <% end %>
          </ul>
        </div>
      </div>
    </nav>

    <!-- Flash messages -->
    <div class="container mt-4">
      <% if notice %>
        <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
          <strong>✅ Success!</strong> <%= notice %>
          <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
      <% end %>

      <% if alert %>
        <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
          <strong>⚠️ Alert!</strong> <%= alert %>
          <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
      <% end %>
    </div>

    <%= yield %>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
  </body>
</html>