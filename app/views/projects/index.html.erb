<%= form_with url: projects_path, method: :get, data: { turbo_frame: "project_list" }, class: "mb-4" do |f| %>
  <div class="input-group mb-3">
    <%= f.text_field :search, value: params[:search], placeholder: "Search project...", class: "form-control" %>
    <button class="btn btn-primary" type="submit">Filter</button>
    <%= link_to "Reset", projects_path, class: "btn btn-outline-secondary", data: { turbo_frame: "project_list" } %>
  </div>
<% end %>

<p class="text-success"><%= notice %></p>

<% content_for :title, "Projects" %>

<div class="d-flex justify-content-between align-items-center mb-3">
  <h1 class="h3 mb-0">Projects</h1>
  <%= link_to "New Project", new_project_path, class: "btn btn-success" %>
</div>

<div id="projects" class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
  <% @projects.each do |project| %>
    <div class="col">
      <div class="card shadow-sm h-100">
        <div class="card-body">
          <h5 class="card-title"><%= project.name %></h5>
          <p class="card-text"><%= truncate(project.description, length: 80) %></p>
          <%= link_to "Show this Project", project_path(project), class: "btn btn-outline-primary btn-sm" %>
        </div>
      </div>
    </div>
  <% end %>
</div>

<hr class="my-4">

