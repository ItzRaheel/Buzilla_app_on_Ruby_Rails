<%= form_with(model: bug, class: "container mt-4") do |form| %>
  <% if bug.errors.any? %>
    <div class="alert alert-danger">
      <h4><%= pluralize(bug.errors.count, "error") %> prohibited this bug from being saved:</h4>
      <ul>
        <% bug.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <!-- Form Card -->
  <div class="card shadow-sm mb-4">
    <!-- <div class="card-header bg-primary text-white">
      <!-- <h4 class="mb-0"><%= bug.new_record? ? "Create New Bug" : "Edit Bug" %></h4> -->
    </div> -->

    <div class="card-body">

      <!-- Name -->
      <div class="mb-3">
        <%= form.label :name, class: "form-label fw-bold" %>
        <%= form.text_field :name, class: "form-control", placeholder: "Enter bug name" %>
      </div>

      <!-- Description -->
      <div class="mb-3">
        <%= form.label :description, class: "form-label fw-bold" %>
        <%= form.text_area :description, class: "form-control", rows: 4, placeholder: "Describe the issue" %>
      </div>

      <!-- Bug Status -->
      <div class="mb-3">
        <%= form.label :bug_status, "Bug Type", class: "form-label fw-bold" %>
        <%= form.select :bug_status, ["Bug", "Feature"], { prompt: "Select Status" }, class: "form-select" %>
      </div>

      <!-- File Upload -->
      <div class="mb-3">
        <%= form.label :file, "Attach Screenshot / Image", class: "form-label fw-bold" %>
        <%= form.file_field :file, class: "form-control", accept: "image/png, image/jpeg, image/gif" %>
        <small class="text-muted">Allowed formats: JPG, PNG, GIF</small>
      </div>

      <!-- Priority -->
      <div class="mb-3">
        <%= form.label :priority, class: "form-label fw-bold" %>
        <%= form.select :priority, ["New", "In Progress", "Completed"], { prompt: "Select Priority" }, class: "form-select" %>
      </div>

      <!-- Project Selection -->
      <div class="mb-3">
        <%= form.label :project_id, "Assign to Project", class: "form-label fw-bold" %>
        <%= form.collection_select :project_id, current_user.projects, :id, :name, { prompt: "Select Project" }, class: "form-select" %>
      </div>

      <!-- Submit Button -->
      <div class="d-flex justify-content-end mt-4">
        <%= form.submit (bug.new_record? ? "Create Bug" : "Update Bug"), class: "btn btn-success px-4" %>
      </div>

    </div>
  </div>
<% end %>
