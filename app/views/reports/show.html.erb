<div class="container mt-5">
  <div class="card shadow-sm border-0 rounded-4">
    <div class="card-header bg-primary text-white rounded-top-4">
      <h3 class="mb-0">Report Details</h3>
    </div>

    <div class="card-body">
      <h4 class="card-title text-dark">
        <strong>Report Name:</strong> 
        <%= @report.report_name.present? ? @report.report_name : "Untitled Report" %>
      </h4>

      <p class="card-text mt-3">
        <strong>Description:</strong><br>
        <%= @report.report_description.present? ? @report.report_description : "No description available." %>
      </p>

      <p class="card-text mt-3">
        <strong>Associated Bug:</strong><br>
        <% if @report.bug.present? %>
          <span class="badge bg-info text-dark"><%= @report.bug.name %></span>
        <% else %>
          <span class="text-muted">No bug linked.</span>
        <% end %>
      </p>
    </div>

    <div class="card-footer bg-light text-center rounded-bottom-4">
      <%= link_to "Back to Reports", reports_path, class: "btn btn-outline-primary px-4 me-2" %>
      <%= link_to "Edit Report", edit_report_path(@report), class: "btn btn-outline-secondary px-4" %>
    </div>
  </div>
</div>
